# 12. USER INPUT PREDICTION
# ============================================

print("\n================================")
print("     IRIS FLOWER PREDICTION")
print("================================")

print("\nEnter Flower Measurements:")

sepal_length = float(input("Enter Sepal Length: "))
sepal_width = float(input("Enter Sepal Width: "))
petal_length = float(input("Enter Petal Length: "))
petal_width = float(input("Enter Petal Width: "))


# Put user input into the required format
user_input = [[
    sepal_length,
    sepal_width,
    petal_length,
    petal_width
]]


# Predict the flower using Random Forest
prediction = rf.predict(user_input)


# Convert prediction number into flower name
predicted_flower = iris.target_names[prediction[0]]


# Display result
print("\n================================")
print("       PREDICTION RESULT")
print("================================")

print("Predicted Flower:", predicted_flower)
